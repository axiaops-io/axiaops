# Copy to .env and fill in real values, then (from the repo root):
#   docker compose -f deploy/docker/docker-compose.yml --env-file deploy/docker/.env up -d
# .env is gitignored — never commit real credentials.

# --- Required secrets (no defaults — the stack refuses to start without them) ---

# Encrypts accounts.secret_encrypted (connected-account AWS credentials) at
# rest. Generate once and keep it — losing it makes every connected account
# unrecoverable. openssl rand -hex 32
ENCRYPTION_KEY=

# C-1 shared-secret HMAC for the api -> ingestion hop. openssl rand -hex 32
INGESTION_SHARED_SECRET=
# Leave unset unless rotating INGESTION_SHARED_SECRET (verifier-side only).
INGESTION_SHARED_SECRET_NEXT=

# Postgres role passwords — three distinct roles, see docs/AUTHENTICATION.md
# Section 5. Use three different values, not the same password three times.
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=

# Valkey/Redis auth (JWKS cache, rate limiting, scan job queue).
REDIS_PASSWORD=

# Externally-reachable origin this stack will actually be served at —
# required for OIDC redirect_uri and invite/password-reset links. Must
# match whatever your edge reverse proxy exposes, e.g.:
PUBLIC_HOST=https://axiaops.example.com

# Image version. No default on purpose — this project has no stable release
# line yet (every tag is alpha/beta), so silently floating to an undeclared
# "latest" would risk an untested build landing on infra that runs DB
# migrations and encrypts secrets at rest. Pick a real, deliberate tag from
# https://github.com/axiaops-io/axiaops/releases, e.g. 1.0.0
# (no "v" prefix — this repo's tags are plain semver)
AXIAOPS_VERSION=

# --- Optional ---

# Only needed for a true cross-origin deployment (dashboard and api on
# different hostnames). Leave unset for the default same-origin shape.
# CORS_ORIGIN=

# Image registry. Defaults to the published GHCR images.
# AXIAOPS_REGISTRY=ghcr.io/axiaops-io/axiaops

# Leave unset. The published GHCR images are always the production shape
# (DEV_MODE compiled out at build time by ci.yml/release.yml) — there is no
# "-production" variant to opt into, unlike the private-registry Helm chart
# default. Only set this if you're pointing AXIAOPS_REGISTRY at your own
# registry with differently-suffixed tags.
# AXIAOPS_IMAGE_SUFFIX=

# Local port the dashboard container listens on (put a reverse proxy with
# TLS in front of it — do not expose this directly to the internet).
# DASHBOARD_PORT=8082

# How often ingestion checks for accounts due a scan.
# SCAN_INTERVAL=60m

# Directory containing AWS credentials, mounted read-only into ingestion for
# accounts using AWS_ACCESS_KEY_ID/SECRET auth. Omit/ignore entirely if every
# connected account uses RoleARN instead.
# AWS_CREDENTIALS_DIR=~/.aws

# Invite/password-reset email relay. Leave unset to disable email delivery
# (invites still work — the redemption link is just not emailed).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=AxiaOps
