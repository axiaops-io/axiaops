# Copy to .env, fill in values, then (from repo root):
#   docker compose -f deploy/docker/docker-compose.yml --env-file deploy/docker/.env up -d
# .env is gitignored.

# --- Required ---

# openssl rand -hex 32. Encrypts connected-account credentials at rest.
ENCRYPTION_KEY=

# openssl rand -hex 32. api -> ingestion HMAC.
INGESTION_SHARED_SECRET=
# Only for rotation (verifier-side).
INGESTION_SHARED_SECRET_NEXT=

# Three distinct passwords — see docs/AUTHENTICATION.md §5.
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=

REDIS_PASSWORD=

# Externally-reachable origin (OIDC redirect_uri, invite/reset links).
PUBLIC_HOST=https://axiaops.example.com

# Pick a tag from https://github.com/axiaops-io/axiaops/releases
AXIAOPS_VERSION=

# --- Optional ---

# Point at RDS/ElastiCache instead of the bundled containers. Also layer in
# docker-compose.external-db.yml, which drops postgres/redis entirely:
#   docker compose -f deploy/docker/docker-compose.yml -f deploy/docker/docker-compose.external-db.yml --env-file deploy/docker/.env up -d
# POSTGRES_HOST=mydb.xxxxx.eu-central-1.rds.amazonaws.com
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require
# REDIS_HOST=my-cache.xxxxx.cache.amazonaws.com
# REDIS_PORT=6379

# Only for cross-origin dashboard/api hosts.
# CORS_ORIGIN=

# AXIAOPS_REGISTRY=ghcr.io/axiaops-io/axiaops

# Only if AXIAOPS_REGISTRY points at your own registry with suffixed tags.
# GHCR images are always the production shape already.
# AXIAOPS_IMAGE_SUFFIX=

# Put a TLS reverse proxy in front; don't expose this directly.
# DASHBOARD_PORT=8082

# SCAN_INTERVAL=60m

# Read-only mount for AWS_ACCESS_KEY_ID/SECRET-based accounts.
# Omit if every account uses RoleARN.
# AWS_CREDENTIALS_DIR=~/.aws

# Invite/reset email relay. Unset = delivery skipped, links still work.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=AxiaOps
